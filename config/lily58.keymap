#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BaseLayer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&trans          &kp W           &kp E        &kp R             &kp T        &none                            &none        &kp Y            &kp U              &kp I        &kp O            &none
&kp Q           &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G        &none                            &none        &kp H            &mt RIGHT_SHIFT J  &mt RCTRL K  &mt RIGHT_ALT L  &kp SEMICOLON
&mt LEFT_WIN A  &kp X           &kp C        &kp V             &kp B        &none                            &none        &kp N            &kp M              &kp COMMA    &kp PERIOD       &mt RIGHT_WIN P
&lt 3 Z         &none           &none        &none             &none        &none      &kp LBKT    &kp RBKT  &none        &none            &none              &none        &none            &lt 3 SLASH
                                             &lt 4 ESC         &lt 1 SPACE  &lt 2 TAB  &trans      &trans    &lt 6 ENTER  &lt 5 BACKSPACE  &lt 7 DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NavigationLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &kp LC(Y)      &kp LC(V)       &kp LC(C)       &kp LC(X)     &trans
&trans        &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans     &kp CLCK       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp LC(Z)
&kp LEFT_WIN  &trans        &trans     &trans          &trans  &trans                    &trans     &kp INSERT     &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp RIGHT_ARROW
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans     &trans         &trans          &trans          &trans        &kp END
                                       &trans          &trans  &trans  &trans    &trans  &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        MouseLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &trans
&trans        &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans     &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &kp LC(Z)
&kp LEFT_WIN  &trans        &trans     &trans          &trans  &trans                    &trans     &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &mmv MOVE_RIGHT
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans     &trans     &trans          &trans          &trans        &msc SCRL_RIGHT
                                       &trans          &trans  &trans  &trans    &trans  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        ButtonLayer {
            bindings = <
&trans        &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LC(Y)  &trans                          &trans     &kp RC(Y)  &kp RC(V)        &kp RC(C)  &kp RC(X)      &trans
&kp LC(Z)     &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans     &trans                          &trans     &trans     &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RC(Z)
&kp LEFT_WIN  &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LC(Y)  &trans                          &trans     &kp RC(Y)  &kp RC(V)        &kp RC(C)  &kp RC(X)      &kp RIGHT_WIN
&kp LC(Z)     &trans        &trans     &trans          &trans     &trans     &trans       &trans  &trans     &trans     &trans           &trans     &trans         &kp RC(Z)
                                       &mkp MCLK       &mkp LCLK  &mkp RCLK  &mkp RCLK    &trans  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        MediaLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans       &trans    &trans      &trans             &trans           &trans
&trans        &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans       &trans    &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&kp LEFT_WIN  &trans        &trans     &trans          &trans  &trans                    &trans       &trans    &trans      &trans             &trans           &kp C_NEXT
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans       &trans    &trans      &trans             &trans           &trans
                                       &trans          &trans  &trans  &trans    &trans  &kp C_PAUSE  &kp C_PP  &kp C_MUTE
            >;
        };

        NumberLayer {
            bindings = <
&trans            &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp RIGHT_BRACKET     &trans                       &trans  &trans  &trans      &trans     &trans         &trans
&kp LEFT_BRACKET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL             &trans                       &trans  &trans  &kp RSHIFT  &kp RCTRL  &kp RIGHT_ALT  &trans
&kp SEMICOLON     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NON_US_BACKSLASH  &trans                       &trans  &trans  &trans      &trans     &trans         &kp RIGHT_WIN
&kp GRAVE         &trans        &trans        &trans        &trans                &trans     &trans    &trans  &trans  &trans  &trans      &trans     &trans         &trans
                                              &kp DOT       &kp NUMBER_0          &kp MINUS  &trans    &trans  &trans  &trans  &trans
            >;
        };

        SymbolLayer {
            bindings = <
&trans          &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE        &trans                       &trans  &trans  &trans           &trans     &trans         &trans
&kp LEFT_BRACE  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS               &trans                       &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &trans
&kp COLON       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp PIPE               &trans                       &trans  &trans  &trans           &trans     &trans         &kp RIGHT_WIN
&kp TILDE       &trans           &trans        &trans                &trans                 &trans     &trans    &trans  &trans  &trans  &trans           &trans     &trans         &trans
                                               &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &trans    &trans  &trans  &trans  &trans
            >;
        };

        FunctionLayer {
            bindings = <
&trans   &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN  &trans                     &trans  &trans  &trans           &trans     &trans         &trans
&kp F12  &kp F4  &kp F5  &kp F6     &kp SCROLLLOCK   &trans                     &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &trans
&kp F11  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK  &trans                     &trans  &trans  &trans           &trans     &trans         &kp RIGHT_WIN
&kp F10  &trans  &trans  &trans     &trans           &trans   &trans    &trans  &trans  &trans  &trans           &trans     &trans         &trans
                         &kp K_APP  &kp SPACE        &kp TAB  &trans    &trans  &trans  &trans  &trans
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
