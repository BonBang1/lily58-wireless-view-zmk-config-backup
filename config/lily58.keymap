#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15  // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        Caps {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <21 22>;
        };

        ToggleGameLayerj {
            bindings = <&tog 8>;
            key-positions = <0 11>;
        };

        Language {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <15 20>;
        };

        Language_2 {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <15 51>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BaseLayer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp Q           &kp W           &kp E        &kp R             &kp T        &none                            &none        &kp Y            &kp U              &kp I        &kp O            &kp SEMICOLON
&hm LEFT_WIN A  &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G        &none                            &none        &kp H            &hm RIGHT_SHIFT J  &hm RCTRL K  &hm RIGHT_ALT L  &hm RGUI P
&lt 3 Z         &kp X           &kp C        &kp V             &kp B        &none                            &none        &kp N            &kp M              &kp COMMA    &kp PERIOD       &lt 3 SLASH
&trans          &none           &none        &none             &none        &none      &kp LBKT    &kp RBKT  &none        &none            &none              &none        &none            &trans
                                             &lt 4 ESC         &lt 1 SPACE  &lt 2 TAB  &trans      &trans    &lt 6 ENTER  &lt 5 BACKSPACE  &lt 7 DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NavigationLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &kp LC(Y)      &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp RC(Z)
&kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans     &kp CLCK       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &kp INSERT     &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans     &trans         &trans          &trans          &trans        &trans
                                       &trans          &trans  &trans  &trans    &trans  &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        MouseLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(RIGHT_WIN)
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans     &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans        &trans        &trans     &trans          &trans  &trans                    &trans     &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans     &trans     &trans          &trans          &trans        &trans
                                       &trans          &trans  &trans  &trans    &trans  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        ButtonLayer {
            bindings = <
&kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LC(Y)  &trans                       &trans     &kp RC(Y)  &kp RC(V)        &kp RC(C)  &kp RC(X)      &kp RC(Z)
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans     &trans                       &trans     &trans     &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI
&kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LC(Y)  &trans                       &trans     &kp RC(Y)  &kp RC(V)        &kp RC(C)  &kp RC(X)      &kp RC(Z)
&trans        &trans        &trans     &trans          &trans     &trans     &trans    &trans  &trans     &trans     &trans           &trans     &trans         &trans
                                       &mkp MCLK       &mkp LCLK  &mkp RCLK  &trans    &trans  &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        MediaLayer {
            bindings = <
&trans        &trans        &trans     &trans          &trans  &trans                    &trans       &trans    &trans        &trans             &trans           &trans
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans  &trans                    &trans       &trans    &kp C_PREV    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
&trans        &trans        &trans     &trans          &trans  &trans                    &trans       &trans    &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_CLR
&trans        &trans        &trans     &trans          &trans  &trans  &trans    &trans  &trans       &trans    &trans        &trans             &trans           &trans
                                       &trans          &trans  &trans  &trans    &trans  &kp C_PAUSE  &kp C_PP  &kp C_MUTE
            >;
        };

        NumberLayer {
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp N8        &kp NUMBER_9  &kp RIGHT_BRACKET     &trans                       &trans  &trans  &trans      &trans     &trans         &trans
&kp SQT           &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL             &trans                       &trans  &trans  &kp RSHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NON_US_BACKSLASH  &trans                       &trans  &trans  &trans      &trans     &trans         &trans
&trans            &trans        &trans        &trans        &trans                &trans     &trans    &trans  &trans  &trans  &trans      &trans     &trans         &trans
                                              &kp DOT       &kp NUMBER_0          &kp MINUS  &trans    &trans  &trans  &trans  &trans
            >;
        };

        SymbolLayer {
            bindings = <
&kp LEFT_BRACE     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE        &trans                       &trans  &trans  &trans           &trans     &trans         &trans
&kp DOUBLE_QUOTES  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp PLUS               &trans                       &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RGUI
&kp TILDE          &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp PIPE               &trans                       &trans  &trans  &trans           &trans     &trans         &trans
&trans             &trans           &trans        &trans                &trans                 &trans     &trans    &trans  &trans  &trans  &trans           &trans     &trans         &trans
                                                  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &trans    &trans  &trans  &trans  &trans
            >;
        };

        FunctionLayer {
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN  &trans                     &trans  &trans  &trans           &trans     &trans         &trans
&kp F11  &kp F4  &kp F5  &kp F6     &kp SCROLLLOCK   &trans                     &trans  &trans  &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RGUI
&kp F10  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK  &trans                     &trans  &trans  &trans           &trans     &trans         &trans
&trans   &trans  &trans  &trans     &trans           &trans   &trans    &trans  &trans  &trans  &trans           &trans     &trans         &trans
                         &kp K_APP  &kp SPACE        &kp TAB  &trans    &trans  &trans  &trans  &trans
            >;
        };

        GameLayer {
            bindings = <
&kp Q   &kp W   &kp E   &kp R    &kp T      &trans                     &trans     &kp Y          &kp U           &kp UP_ARROW    &kp O            &kp SEMICOLON
&kp A   &kp S   &kp D   &kp F    &kp G      &trans                     &trans     &kp H          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp P
&kp Z   &kp X   &kp C   &kp V    &kp B      &trans                     &trans     &kp N          &kp M           &kp COMMA       &kp PERIOD       &kp SLASH
&trans  &trans  &trans  &trans   &trans     &trans   &trans    &trans  &trans     &trans         &trans          &trans          &trans           &trans
                        &kp ESC  &kp SPACE  &kp TAB  &trans    &trans  &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
